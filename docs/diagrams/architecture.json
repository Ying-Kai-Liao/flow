  "cards": [
    {
      "dot": "cyan",
      "title": "Roles",
      "items": [
        "Main splits a request into tasks, one manager each",
        "Managers write briefs and review PRs; they never edit code",
        "Workers build in their own worktree and open a PR",
        "The plugin starts the reviewer; it merges in batches"
      ]
    },
    {
      "dot": "violet",
      "title": "Tools, grouped",
      "items": [
        "Talk: ask, fyi, answer, standing, preflight, note",
        "Plan + checks: plan, test_slot, guard_tests, status",
        "Ship: handover, reviewer, release, push, deploy, check"
      ]
    },
