      "width": 156
    },
    {
      "id": "batch",
      "lane": "reviewer",
      "col": 4,
      "type": "backend",
      "label": "Reviewer batch",
      "sublabel": "merge, full check",
      "tag": "release cut, push",
      "width": 156
    },
    {
      "id": "deploy",
      "lane": "reviewer",
      "col": 5,
      "type": "security",
      "label": "Deploy gates",
      "sublabel": "after-deploy checks",
      "width": 156
    }
  ],
  "edges": [
    {
      "id": "start-manager",
      "from": "request",
      "to": "preflight",
      "label": "one per task",
      "variant": "emphasis"
    },
    {
      "id": "brief",
      "from": "preflight",
      "to": "build",
      "label": "brief",
      "variant": "emphasis"
    },
    {
      "id": "open-pr",
      "from": "build",
      "to": "handover",
      "label": "PR",
      "variant": "emphasis",
      "toSide": "left"
    },
    {
      "id": "hand-over",
      "from": "handover",
      "to": "delay",
      "variant": "emphasis"
    },
    {
      "id": "start-batch",
      "from": "delay",
      "to": "batch",
      "label": "starts",
      "variant": "emphasis"
    },
    {
      "id": "to-deploy",
      "from": "batch",
      "to": "deploy",
      "variant": "emphasis"
    },
    {
      "id": "to-report",
      "from": "deploy",
      "to": "report",
      "label": "report",
      "variant": "emphasis"
    },
    {
      "id": "questions",
      "from": "preflight",
      "to": "ask",
      "label": "questions",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "auto-answer",
      "from": "ask",
      "to": "standing",
      "label": "repeat topic",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "after-done",
      "from": "batch",
      "to": "cleanup",
      "label": "each done",
      "variant": "dashed",
      "role": "branch"
    }
