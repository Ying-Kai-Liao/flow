    "title": "Life of a flow task",
    "quality_profile": "showcase",
    "legend": {
      "mode": "auto",
      "entries": {
        "external": {
          "label": "You"
        },
        "frontend": {
          "label": "Main session"
        },
        "backend": {
          "label": "Agent or plugin step"
        },
        "messagebus": {
          "label": "Inbox or wait"
        },
        "security": {
          "label": "Gate"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "inbox",
      "label": "Inbox",
      "variant": "exception"
    },
    {
      "id": "main",
      "label": "Main session"
    },
    {
      "id": "manager",
      "label": "Manager"
    },
    {
      "id": "worker",
      "label": "Worker"
    },
    {
      "id": "plugin",
      "label": "Plugin"
    },
    {
      "id": "reviewer",
      "label": "Reviewer"
    }
  ],
  "phases": [
    {
      "id": "plan",
      "label": "Plan",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "build",
      "label": "Build + review",
      "fromCol": 2,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "ship",
      "label": "Ship",
      "fromCol": 4,
      "toCol": 5,
      "variant": "dashed"
