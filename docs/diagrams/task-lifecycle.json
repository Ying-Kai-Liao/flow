    {
      "id": "handover",
      "lane": "manager",
      "col": 3,
      "type": "backend",
      "label": "Review + handover",
      "sublabel": "mcp__flow__handover",
      "width": 156
    },
    {
      "id": "build",
      "lane": "worker",
      "col": 2,
      "type": "backend",
      "label": "Worker PR",
      "sublabel": "own worktree",
      "tag": "## Verification",
      "width": 156
    },
    {
      "id": "delay",
      "lane": "plugin",
      "col": 3,
      "type": "messagebus",
      "label": "reviewer_delay",
      "sublabel": "close handovers wait",
