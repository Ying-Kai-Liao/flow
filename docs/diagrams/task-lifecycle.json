  "nodes": [
    {
      "id": "ask",
      "lane": "inbox",
      "col": 1,
      "type": "messagebus",
      "label": "Asks + FYI",
      "sublabel": "ask, decisions",
      "width": 156
    },
    {
      "id": "standing",
      "lane": "inbox",
      "col": 2,
      "type": "messagebus",
      "label": "Standing answers",
      "sublabel": "recurring topics",
      "width": 156
    },
    {
      "id": "request",
      "lane": "main",
      "col": 0,
      "type": "external",
      "label": "Your request",
      "sublabel": "main starts managers",
      "width": 156
